# Kopieer dit bestand lokaal naar .env.
# Vul echte sleutels alleen in .env in; zet .env nooit op GitHub.
KLING_API_KEY=your_new_kling_api_key_here

# Optioneel voor toekomstige Runway-functies:
RUNWAYML_API_SECRET=

# Alleen instellen als Kling de API-route wijzigt:
# KLING_API_BASE_URL=https://api.klingai.com
# KLING_MOTION_PATH=/v1/videos/motion-control
# CLOUDFLARED_PATH=C:\pad\naar\cloudflared.exe
